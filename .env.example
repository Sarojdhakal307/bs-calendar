# Copy to .env and adjust. docker compose reads .env automatically.
# Every value below also has a development default in docker-compose.yml.
# NEVER use these defaults in production.

# --- HTTP ---------------------------------------------------------------------
HTTP_PORT=8080
METRICS_PORT=9090
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated origins, or * (development only).
CORS_ALLOWED_ORIGINS=*
# Set true only behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Clients below this version receive updateRequired=true in the manifest.
MIN_SUPPORTED_CLIENT=0.0.0

# --- Database -----------------------------------------------------------------
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar
POSTGRES_DB=calendar
# Host port (the container listens on 5432).
POSTGRES_PORT=55432

# --- Secrets: generate with  openssl rand -base64 48  ---------------------------
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-0123456789abcdef
WEBHOOK_SECRET_KEY=dev-only-webhook-encryption-key-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Bootstrap (first run) ------------------------------------------------------
DEFAULT_TENANT_SLUG=default
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-now
# Development only: known API keys so curl examples work out of the box.
BOOTSTRAP_PUBLIC_KEY=pk_dev_local_public_key_0001
BOOTSTRAP_SERVER_KEY=sk_dev_local_server_key_0001

# --- API behaviour ----------------------------------------------------------------
REQUIRE_API_KEY=true

# --- Webhooks and CDN -------------------------------------------------------------
# Development only: lets webhooks reach containers and localhost.
ALLOW_PRIVATE_WEBHOOKS=true
# Optional: the worker POSTs {"files":[...]} here after publishes.
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# --- Logging ----------------------------------------------------------------------
# debug, info, warn, error
LOG_LEVEL=info
# json or text
LOG_FORMAT=json
