# Production configuration for deploy/compose/docker-compose.prod.yml.
# Copy to .env.production, fill in every REQUIRED value, and keep the file out of git (chmod 600).
# Any variable can also come from a file: set NAME_FILE=/run/secrets/name instead of NAME.
# The service refuses to start in production with development values (see docs/deployment.md).

# --- Image and host -------------------------------------------------------------------
IMAGE=ghcr.io/your-org/calendar-api
# VERSION is usually exported in the shell per deploy (export VERSION=v1.0.0).
DOMAIN=calendar-api.example.org               # REQUIRED: DNS A/AAAA record → this VM
ACME_EMAIL=ops@example.org                    # REQUIRED: Let's Encrypt account e-mail
API_REPLICAS=2

# --- Environment ----------------------------------------------------------------------
APP_ENV=production
PUBLIC_BASE_URL=https://calendar-api.example.org   # REQUIRED: must be https
LOG_LEVEL=info
LOG_FORMAT=json

# --- Database -------------------------------------------------------------------------
# Least-privilege roles: run deploy/postgres/roles.sql once, then:
MIGRATION_DATABASE_URL=postgres://calendar_owner:CHANGE_ME@db-host:5432/calendar?sslmode=require   # REQUIRED (bootstrap only)
DATABASE_URL=postgres://calendar_app:CHANGE_ME@db-host:5432/calendar?sslmode=require               # REQUIRED (api, worker)
DB_MAX_CONNS=10
DB_STATEMENT_TIMEOUT=15s
# Only with --profile bundled-db. db-host above is then "postgres", sslmode=disable (private
# Docker network), and the two role passwords below must match the ones in the URLs.
POSTGRES_USER=calendar_admin
POSTGRES_PASSWORD=
POSTGRES_DB=calendar
CALENDAR_OWNER_PASSWORD=
CALENDAR_APP_PASSWORD=
BACKUP_KEEP_DAYS=14

# --- Secrets: generate each with  openssl rand -base64 48 ------------------------------
JWT_SIGNING_KEY=                               # REQUIRED
WEBHOOK_SECRET_KEY=                            # REQUIRED (never change it once webhooks exist)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- First super admin (created once by bootstrap; change the password after first login) ---
BOOTSTRAP_ADMIN_EMAIL=you@example.org
BOOTSTRAP_ADMIN_PASSWORD=                      # REQUIRED on first deploy, at least 12 characters
# Do NOT set BOOTSTRAP_PUBLIC_KEY / BOOTSTRAP_SERVER_KEY in production: issue keys in the admin API.

# --- HTTP behaviour ---------------------------------------------------------------------
TRUST_PROXY=true                               # Caddy sets X-Forwarded-For
CORS_ALLOWED_ORIGINS=https://www.example.org,https://admin.example.org
ADMIN_ALLOWED_CIDRS=                           # e.g. 203.0.113.0/24,10.0.0.0/8 (office / VPN); empty = anywhere
REQUIRE_API_KEY=true
ALLOW_PRIVATE_WEBHOOKS=false
MIN_SUPPORTED_CLIENT=1.0.0
REQUEST_TIMEOUT=30s
SHUTDOWN_DRAIN=5s

# --- CDN (optional) ---------------------------------------------------------------------
# Cloudflare: https://api.cloudflare.com/client/v4/zones/<zone-id>/purge_cache with an API token
# that has Cache Purge permission. The 30 s manifest TTL is the real freshness guarantee.
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
